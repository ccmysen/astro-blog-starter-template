---
const today = new Date();
---

<footer>
	<p>&copy; {today.getFullYear()} Obsidian Plugins. All rights reserved.</p>
	<p>
		<a href="/privacy-policy/" class="footer-link">Privacy Policy</a>
		<span class="separator">|</span>
		<a href="/terms/" class="footer-link">Terms of Service</a>
	</p>
</footer>
<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: #ffffff;
		color: rgb(var(--gray));
		text-align: center;
		border-top: 1px solid #eaeaea;
	}
	footer p {
		margin: 0.5em 0;
	}
	.footer-link {
		color: rgb(var(--gray));
		font-size: 0.9rem;
		text-decoration: none;
	}
	.footer-link:hover {
		color: rgb(var(--gray-dark));
		text-decoration: underline;
	}
	.separator {
		color: #cbd5e1;
		margin: 0 0.5rem;
		font-size: 0.9rem;
	}
</style>
